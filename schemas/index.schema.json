{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private Advisor Market Index",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "packages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "integer" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packageId", "slug", "displayName", "categoryId", "latestVersion", "versions"],
        "additionalProperties": false,
        "properties": {
          "packageId": { "type": "string" },
          "slug": { "type": "string" },
          "displayName": { "type": "string" },
          "profession": { "type": "string" },
          "description": { "type": "string" },
          "categoryId": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "latestVersion": { "type": "string" },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "releaseUrl", "sha256"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "string" },
                "releaseUrl": { "type": "string" },
                "sha256": { "type": "string" },
                "signature": { "type": "string" },
                "sizeBytes": { "type": "integer" },
                "publishedAt": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
