{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private Advisor Expert Definition",
  "type": "object",
  "required": ["displayName", "profession", "description"],
  "additionalProperties": true,
  "properties": {
    "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
    "profession": { "type": "string", "minLength": 1, "maxLength": 40 },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 80,
      "description": "市场展示描述，建议 40–50 字"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 12 }
    },
    "quickPrompts": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 30 }
    },
    "welcomeMessage": { "type": "string", "maxLength": 60 },
    "recommendedModel": { "type": "string" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "knowledgeHint": { "type": "string", "maxLength": 60 }
  }
}
